# Yerel sunucu / admin paneli
ADMIN_PASSWORD=1234
# İsteğe bağlı: panel kullanıcı e-posta girişi (Kullanıcılar sekmesinden yönetilir)
# ADMIN_EMAIL=admin@patygoteknoloji.com
PORT=5173
SITE_BASE_URL=https://patygoteknoloji.com
# Canlıda IP veya localhost yazmayın; ödeme/Akakçe bu adresi kullanır.

# Akakçe XML v1.3 (KDV dahil fiyat site ile aynı; kargo/teslimat sabitleri)
# AKAKCE_SHIP_PRICE=0.00
# AKAKCE_DAY_OF_DELIVERY=2
# AKAKCE_EXPRESS_DELIVERY_HOUR=16

# Tedarikçi XML (gerçek bağlantıyı yalnızca .env veya admin panelinden kaydedin)
# Çekim yalnızca kayıtlı çıkış IP’lerinden: VPS 87.76.157.41, entegratör 195.155.129.41
# Yerel PC’den canlı XML çekmeyin (IP engeli).
SUPPLIER_XML_URL=
SUPPLIER_XML_URL_2=
SUPPLIER_XML_URL_3=
# Yalnızca gerçek tedarikçi alan adları
SUPPLIER_ALLOWED_HOSTS=www.bilgisayarim.com.tr
SUPPLIER_MARGIN_PERCENT=15

# Akbank SecurePay (sanalpos.akbank.com → MerchantSafeID / TerminalSafeID / Secret Key)
# Anahtarları sohbete yapıştırmayın; yalnızca bu .env dosyasına yazın.
AKBANK_MERCHANT_SAFE_ID=
AKBANK_TERMINAL_SAFE_ID=
AKBANK_SECRET_KEY=
# true = test (apipre / payhosting pre), false = canlı
AKBANK_TEST_MODE=true
# Desteklenen model: 3D_PAY_HOSTING (kart banka sayfasında)
AKBANK_PAYMENT_MODEL=3D_PAY_HOSTING

# İletişim formu (info@patygoteknoloji.com)
# SMTP tanımlıysa doğrudan mail; yoksa iletişim formu FormSubmit yedek kanalını kullanır.
# Sipariş ve takvim mailleri yalnızca SMTP ile gider; FormSubmit kullanılmaz.
CONTACT_TO=info@patygoteknoloji.com
# Google Workspace / Gmail App Password:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@patygoteknoloji.com
SMTP_PASS=
SMTP_FROM=Patygo Teknoloji <info@patygoteknoloji.com>

# BizimHesap muhasebe (ödeme sonrası satış faturası/sipariş aktarımı)
# Key/Token/FirmID: destek@bizimhesap.com veya panel yardım formu
# BIZIMHESAP_API_BASE=https://bizimhesap.com/api/b2b
# BIZIMHESAP_FIRM_ID=
# BIZIMHESAP_API_KEY=
# BIZIMHESAP_API_TOKEN=
